# BUSRIFY E-Commerce Store Configuration Template

# Server Port
PORT=3000

# Authentication Session Secret
SESSION_SECRET=busrify-store-secret-key-2026-secure

# MongoDB Database Connection URI
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/busrify_store
# Or MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/busrify_store?retryWrites=true&w=majority

# Fallback to local SQLite if MongoDB is unreachable
MONGODB_FALLBACK_SQLITE=true
